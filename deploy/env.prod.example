# ---------------------------------------------------------------------------
# Server configuration (demo deployment). Copy to .env ON THE SERVER and fill in.
# Everything marked ZMIEŃ must differ from the local setup.
# ---------------------------------------------------------------------------

# ZMIEŃ: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false

# The subdomain the provider gave you, without https://
DJANGO_ALLOWED_HOSTS=twoja-subdomena.wykr.es
# With the scheme — Django checks the Origin header of POST requests against this
DJANGO_CSRF_TRUSTED_ORIGINS=https://twoja-subdomena.wykr.es

# Public port assigned to the VPS; the provider's proxy forwards the subdomain here
APP_PORT=20000

# Drives QR codes and e-mail links. Wrong value = printed codes point nowhere.
APP_BASE_URL=https://twoja-subdomena.wykr.es

# One proxy in front of the app: the rate limiter reads the client IP from the
# rightmost X-Forwarded-For entry. Never set this higher than the real number of proxies.
TRUSTED_PROXY_HOPS=1

# Start with false. Turn on only after confirming the proxy sends X-Forwarded-Proto —
# otherwise Django redirects to https, the proxy forwards http, and the loop never ends.
DJANGO_SECURE_SSL_REDIRECT=false

# ZMIEŃ: a non-obvious path for the technical Django admin
DJANGO_ADMIN_URL=ukryty-panel-django/

# ZMIEŃ: database password
POSTGRES_DB=greeninnowacje
POSTGRES_USER=greeninnowacje
POSTGRES_PASSWORD=

# MapTiler: remember to add the subdomain to the key's allowed origins
MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TWOJ_KLUCZ
MAP_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GreenInnowacje-Drzewa/1.0 (kontakt@greeninnowacje.pl)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Scheduled jobs run in local time (05:00 weather, 07:00 statuses)
TZ=Europe/Warsaw

# E-mail: empty SMTP_HOST prints messages to the log instead of sending them (M3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Green Innowacje <noreply@greeninnowacje.pl>

# Uploaded tree photos (Etap 2). Files are never served by the web server — an authenticated
# Django view streams them, so this directory does not need to be public.
MEDIA_ROOT=
# Swap for django-storages (S3/R2) when the hosting is decided; the application code does not
# change, only this line.
DEFAULT_FILE_STORAGE=
