# ---------------------------------------------------------------------------
# Green Innowacje — environment variables. Copy to `.env` and fill in.
# Drought thresholds are NOT here — they live in the `config` table (admin panel).
# ---------------------------------------------------------------------------

# Django signing key for sessions/CSRF (the spec's SESSION_SECRET).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=zmien-mnie
# true only locally; false in production (enables HTTPS-only cookies, HSTS, redirect)
DJANGO_DEBUG=true
# hosts the app is served under (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# full origins for CSRF behind a proxy, e.g. https://drzewa.greeninnowacje.pl
DJANGO_CSRF_TRUSTED_ORIGINS=
# Reverse proxies in front of the app that append to X-Forwarded-For (1 behind Caddy,
# 0 locally). Used to find the real client IP for rate limiting — never set it higher
# than the real number of proxies, or clients can spoof their IP.
TRUSTED_PROXY_HOPS=0
# path of the technical Django admin (NOT /admin/ — that is the app's panel); use a non-obvious one in prod
DJANGO_ADMIN_URL=django-admin/

# PostgreSQL 16. This URL is for tools run on the host (uv run pytest, manage.py);
# the `app` container in docker-compose.yml overrides it with db:5432.
DATABASE_URL=postgres://greeninnowacje:greeninnowacje@localhost:5433/greeninnowacje
POSTGRES_DB=greeninnowacje
POSTGRES_USER=greeninnowacje
POSTGRES_PASSWORD=greeninnowacje

# Base URL for links in QR codes and e-mails
APP_BASE_URL=http://localhost:8000
# Map tiles. Leave unset in development (OSM Deutschland tiles, no key needed).
# Production: MapTiler with a domain-restricted key (spec §1). Do not point this at
# tile.openstreetmap.org — it blocks application traffic under its usage policy.
# MAP_TILES_URL=
# MAP_ATTRIBUTION=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# SMTP (Brevo-compatible). Empty SMTP_HOST = e-mails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
MAIL_FROM=Green Innowacje <noreply@greeninnowacje.pl>
